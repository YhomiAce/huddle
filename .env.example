# Postgres connection string (required in production)
DATABASE_URL=postgresql://postgres:fleetdev@127.0.0.1:55432/huddle
# Redis connection string; the path selects the DB index (required in production)
REDIS_URL=redis://127.0.0.1:56379/4
# Long random string used to sign session tokens (required in production, 16+ chars)
SESSION_SECRET=replace-with-a-long-random-string
# Show the demo accounts on the login page
DEMO_MODE=true
# Trust X-Forwarded-* headers from a reverse proxy (needed for Secure cookies behind TLS)
TRUST_PROXY=true
# Port to listen on (dev server uses 5113, the Vite dev server proxies to it)
PORT=5113
